#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
devtools_options.yaml
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.symbols
*.symbols
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Kotlin daemon session files (machine-local, regenerated every build)
/android/.kotlin/

# AI assistant local state
.narrafork/

# Rust build cache (regenerated by cargo, can be multiple GB)
/rust/target/

# Android build artifacts
/android/build/

# Project-local CMake (downloaded/extracted by clean-build script, machine-local)
/android/cmake-3.22.1/
/android/cmake-3.22.1-windows.zip

# Static analysis output
/analyze_out.txt

# Release binaries — use GitHub Releases instead of committing APKs
/releases/

# Flutter Rust Bridge generated cache
*.g.dart.tmp

# Native prebuilt libraries (built by cargo, regenerated every build — never commit)
# 注意：ffmpeg 裁剪版 .so（scripts/ffmpeg-trim 产物，手工构建、不会自动再生）
# 也放在 jniLibs 下覆盖 AAR 完整版同名库，必须入库——整目录忽略会让换机/CI
# 构建静默回退到 pub 完整版（APK 无声膨胀 7MB），故改 /* + 例外规则。
/android/app/src/main/jniLibs/*
!/android/app/src/main/jniLibs/arm64-v8a/
/android/app/src/main/jniLibs/arm64-v8a/*
!/android/app/src/main/jniLibs/arm64-v8a/libavcodec.so
!/android/app/src/main/jniLibs/arm64-v8a/libavdevice.so
!/android/app/src/main/jniLibs/arm64-v8a/libavfilter.so
!/android/app/src/main/jniLibs/arm64-v8a/libavformat.so
!/android/app/src/main/jniLibs/arm64-v8a/libavutil.so
!/android/app/src/main/jniLibs/arm64-v8a/libswresample.so
!/android/app/src/main/jniLibs/arm64-v8a/libswscale.so

# Flutter-generated ephemeral build metadata (machine-specific paths)
**/Flutter/ephemeral/
**/ephemeral/

# 音源脚本取样：含用户私有 API 密钥，仅供本地验证，不得入库
/rust/examples/fixtures/

# Flutter 构建自动生成物
**/GeneratedPluginRegistrant.*

# 调试遗留（截图/空文件）
/flutter_*.png
/null

# 软著登记材料（操作说明书/源代码 PDF 含完整源码，仅本地使用，不入库）
/soft-copyright/
