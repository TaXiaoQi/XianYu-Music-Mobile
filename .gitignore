# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
devtools_options.yaml
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.symbols
*.symbols
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Kotlin daemon session files (machine-local, regenerated every build)
/android/.kotlin/

# AI assistant local state
.narrafork/

# Rust build cache (regenerated by cargo, can be multiple GB)
/rust/target/

# Android build artifacts
/android/build/

# Project-local CMake (downloaded/extracted by clean-build script, machine-local)
/android/cmake-3.22.1/
/android/cmake-3.22.1-windows.zip

# Static analysis output
/analyze_out.txt

# Release binaries — use GitHub Releases instead of committing APKs
/releases/

# Flutter Rust Bridge generated cache
*.g.dart.tmp

# Native prebuilt libraries：libxianyu_core.so 由 cargo 每次构建再生，绝不入库
/android/app/src/main/jniLibs/

# ffmpeg-trim 重建产物（与 jniLibs 入库副本同源），仅本机留存防仓库冗余
/scripts/ffmpeg-trim/dist/

# Flutter-generated ephemeral build metadata (machine-specific paths)
**/Flutter/ephemeral/
**/ephemeral/

# 音源脚本取样：含用户私有 API 密钥，仅供本地验证，不得入库
/rust/examples/fixtures/

# Flutter 构建自动生成物
**/GeneratedPluginRegistrant.*

# 调试遗留（截图/空文件）
/flutter_*.png
/null

# 软著登记材料（操作说明书/源代码 PDF 含完整源码，仅本地使用，不入库）
/soft-copyright/

# Signing credentials — never commit
/android/key.properties
/android/app/*.keystore
/android/app/*.jks

# 鸿蒙依赖覆盖（脚本每次从 scripts/ohos/pubspec-ohos-overrides.yaml 模板重写，
# 常驻本机但不得入库——它会整体替换 pubspec 的 dependency_overrides）
/pubspec_overrides.yaml

# 鸿蒙就地构建的 ohpm 物化产物（third_party har 模块，构建时自动生成）
**/oh_modules/
third_party/*/ohos/oh-package-lock.json5
third_party/*/ohos/BuildProfile.ets
third_party/*/ohos/build/
# 鸿蒙就地构建产物：rust .so 与 flutter_assets（每次构建重新生成）
/ohos/entry/libs/
/ohos/entry/src/main/resources/rawfile/

# fork 依赖自带的示例工程（仅上游参考用，不入库）
/third_party/just_audio/example/

# 软著申请材料不入库
软著申请材料/
