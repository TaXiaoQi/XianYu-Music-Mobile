# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
devtools_options.yaml
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Kotlin daemon session files (machine-local, regenerated every build)
/android/.kotlin/

# AI assistant local state
.narrafork/

# Rust build cache (regenerated by cargo, can be multiple GB)
/rust/target/

# Android build artifacts
/android/build/

# Project-local CMake (downloaded/extracted by clean-build script, machine-local)
/android/cmake-3.22.1/
/android/cmake-3.22.1-windows.zip

# Static analysis output
/analyze_out.txt

# Release binaries — use GitHub Releases instead of committing APKs
/releases/

# Flutter Rust Bridge generated cache
*.g.dart.tmp

# Native prebuilt libraries (built by cargo, regenerated every build — never commit)
/android/app/src/main/jniLibs/

# Flutter-generated ephemeral build metadata (machine-specific paths)
**/Flutter/ephemeral/
**/ephemeral/

# 音源脚本取样：含用户私有 API 密钥，仅供本地验证，不得入库
/rust/examples/fixtures/
