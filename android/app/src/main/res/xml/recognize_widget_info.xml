<?xml version="1.0" encoding="utf-8"?>
<!-- previewImage 用位图：layer-list 在部分 ROM（MagicOS 等）选择器上渲染
     失效，见 square_widget_info.xml 注释；画面改动后重跑
     scripts/gen-widget-previews.ps1。 -->
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="140dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="250dp"
    android:minResizeHeight="140dp"
    android:maxResizeWidth="250dp"
    android:maxResizeHeight="140dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/player_widget_recognize"
    android:previewImage="@drawable/widget_preview_recognize"
    android:resizeMode="none"
    android:widgetCategory="home_screen" />
<!-- 不设 previewLayout：MagicOS 长按浮层渲染 previewLayout 后把实时
     RemoteViews 动作叠上去，静态预览布局缺 songText/bgCover 等 id，
     动作应用失败会退回丢圆角收尾的降级渲染（活数据+方角，2026-10
     实测）。无 previewLayout 时浮层直接用实时渲染，配合位图自圆
     （a76d277）各路径恒圆角；选择器预览由 previewImage 位图兜住。 -->