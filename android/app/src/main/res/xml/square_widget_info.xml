<?xml version="1.0" encoding="utf-8"?>
<!-- previewImage 用位图：layer-list 在部分 ROM（MagicOS 等）选择器上 item
     尺寸/gravity 渲染失效（红渐变层被拉成怪异色块）。位图全 ROM 像素级
     原样绘制；画面改动后重跑 scripts/gen-widget-previews.ps1 再生成。 -->
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="140dp"
    android:minHeight="140dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:minResizeWidth="140dp"
    android:minResizeHeight="140dp"
    android:maxResizeWidth="140dp"
    android:maxResizeHeight="140dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/player_widget_2x2"
    android:previewImage="@drawable/widget_preview_square"
    android:previewLayout="@layout/player_widget_preview_square"
    android:resizeMode="none"
    android:widgetCategory="home_screen" />