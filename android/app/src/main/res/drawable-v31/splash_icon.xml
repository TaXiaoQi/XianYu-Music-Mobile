<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 系统闪屏图标（方案 1：背景透明，去掉白色方形卡片）。
     背景层用透明：系统闪屏底色由 windowSplashScreenBackground =
     @color/splash_background（昼白 / 夜 #121212）提供，前景 splash_foreground
     （透明底裸 logo）直接呈现，深浅色统一为「无卡片、仅有 logo」，避免
     浅色模式下 solid 背景块被部分 ROM 渲染成可见的直角方形。
     注意（历史坑，保留备忘）：
     - EMUI 曾把 adaptive icon 透明背景层垫成黑色（黑方块），故若需照顾
       EMUI 机型，可退回背景层填 @color/splash_background 的方案；
     - 前景 splash_foreground 按 0.31 占比预缩放进 108dp 方形画布，并带
       drawable-night 反白变体。启动器图标不受影响。 -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/transparent"/>
    <foreground android:drawable="@drawable/splash_foreground"/>
</adaptive-icon>
