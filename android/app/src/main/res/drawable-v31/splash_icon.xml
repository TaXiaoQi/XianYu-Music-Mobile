<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 系统闪屏图标 · 浅色（夜间见 drawable-night-v31 同名文件）。
     前景与深色版同源（@drawable/splash_foreground 日间深色 logo 变体，
     0.31 占比），保证昼夜 logo 显示大小一致；曾用启动器前景
     ic_launcher_foreground（0.41 占比）比深色大 32%，已对齐。
     背景 HyperOS（澎湃 Android 16）会离屏合成方形容器+1px 暗毛边，浅色
     白底上呈「方框」；荣耀无对比跳过背景层只画裸 logo。 -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/splash_background"/>
    <foreground android:drawable="@drawable/splash_foreground"/>
</adaptive-icon>
