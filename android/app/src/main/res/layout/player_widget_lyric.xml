<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面播放组件 · 歌词卡 4×3（独立组件入口，系统通知式平面底色，随系统明暗反转）。
     结构（控件与歌名互换版，参考酷狗 4×3 排布）：
     左列 = 大封面（占满上部）+ 底部三控制钮（上一首/品牌红播放/下一首）；
     右列 = 顶部歌名 / 歌手·弦予音乐 + 五行歌词窗口 + 细进度条。
     歌词窗口：当前行固定映射到 lyricLine3（加粗主色，RemoteViews 无法运行时改字重，
     由 provider 滚动窗口让当前行永远落在该行），上下邻行渐淡。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- 左列：固定方形封面（垂直居中，与右列信息块中心对齐）+ 底部三控制钮 -->
    <LinearLayout
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/cover"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/widget_label" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/widget_btn_circle"
                android:src="@drawable/ic_skip_previous"
                android:tint="@color/widget_icon"
                android:scaleType="centerInside"
                android:contentDescription="@string/widget_label" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/widget_play_btn"
                android:src="@drawable/ic_play"
                android:scaleType="centerInside"
                android:contentDescription="@string/widget_label" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/widget_btn_circle"
                android:src="@drawable/ic_skip_next"
                android:tint="@color/widget_icon"
                android:scaleType="centerInside"
                android:contentDescription="@string/widget_label" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右列：歌名 / 歌手·来源 / 五行歌词窗口 / 细进度条 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/songText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
                android:ellipsize="end" />

        <TextView
            android:id="@+id/artistText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10.5sp"
            android:textStyle="italic"
            android:singleLine="true"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/lyricLine1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="14dp"
                android:textColor="@color/widget_lyric_far"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/lyricLine2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:minHeight="15dp"
                android:textColor="@color/widget_lyric_near"
                android:textSize="11.5sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- 当前行：固定居中、加粗主色 -->
            <TextView
                android:id="@+id/lyricLine3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:minHeight="17dp"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/lyricLine4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:minHeight="15dp"
                android:textColor="@color/widget_lyric_near"
                android:textSize="11.5sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/lyricLine5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:minHeight="14dp"
                android:textColor="@color/widget_lyric_far"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_drawable"
            android:maxHeight="4dp"
            android:minHeight="4dp" />
    </LinearLayout>
</LinearLayout>
