<?xml version="1.0" encoding="utf-8"?>
<!-- 识曲 4×2 的静态预览（仅用于桌面组件选择面板）：
     结构对真实识曲卡(player_widget_recognize)：方形封面 + 歌名/歌手 + 分享钮 +
     三控制键 + 进度条，预置演示文案与封面占位渐变，呈现可读的真实卡片。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg">

    <FrameLayout
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginStart="12dp"
        android:layout_gravity="center_vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_preview_cover"
            android:scaleType="centerCrop"
            android:contentDescription="@string/widget_label" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:orientation="vertical"
        android:gravity="top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_song"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/widget_preview_artist"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageButton
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:src="@drawable/ic_notif_share"
                android:tint="@color/widget_icon"
                android:scaleType="fitCenter"
                android:contentDescription="@string/widget_label" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="4dp"
                android:background="@drawable/widget_btn_circle"
                android:src="@drawable/ic_skip_previous"
                android:tint="@color/widget_icon"
                android:scaleType="centerInside"
                android:contentDescription="@string/widget_label" />

            <ImageButton
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/widget_play_btn"
                android:src="@drawable/ic_play"
                android:scaleType="centerInside"
                android:contentDescription="@string/widget_label" />

            <ImageButton
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="4dp"
                android:background="@drawable/widget_btn_circle"
                android:src="@drawable/ic_skip_next"
                android:tint="@color/widget_icon"
                android:scaleType="centerInside"
                android:contentDescription="@string/widget_label" />
        </LinearLayout>

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="45"
            android:progressDrawable="@drawable/widget_progress_drawable"
            android:maxHeight="3dp"
            android:minHeight="3dp" />
    </LinearLayout>
</LinearLayout>