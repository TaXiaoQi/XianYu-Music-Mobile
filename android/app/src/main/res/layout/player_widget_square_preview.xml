<?xml version="1.0" encoding="utf-8"?>
<!-- 方形 2×2 的静态预览（仅用于桌面组件选择面板）：
     结构对真实方形卡(player_widget_2x2)：封面(居中) + 歌名/歌手 + 底部三大键，
     预置演示文案与封面占位渐变，呈现一张可读的真实卡片。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:maxWidth="76dp"
            android:maxHeight="76dp"
            android:src="@drawable/widget_preview_cover"
            android:scaleType="centerCrop"
            android:contentDescription="@string/widget_label" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_horizontal"
        android:text="@string/widget_preview_song"
        android:textColor="@color/widget_text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:gravity="center_horizontal"
        android:text="@string/widget_preview_artist"
        android:textColor="@color/widget_text_secondary"
        android:textSize="10.5sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="4dp"
            android:background="@drawable/widget_btn_circle"
            android:src="@drawable/ic_skip_previous"
            android:tint="@color/widget_icon"
            android:scaleType="centerInside"
            android:contentDescription="@string/widget_label" />

        <ImageButton
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_play_btn"
            android:src="@drawable/ic_play"
            android:scaleType="centerInside"
            android:contentDescription="@string/widget_label" />

        <ImageButton
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="4dp"
            android:background="@drawable/widget_btn_circle"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/widget_icon"
            android:scaleType="centerInside"
            android:contentDescription="@string/widget_label" />
    </LinearLayout>
</LinearLayout>