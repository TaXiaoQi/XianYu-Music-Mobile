<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面播放组件 · 横条（方形组件切到 4×2 时用）：
     左封面方形（96dp）垂直居中 + 右列三行结构：
     行1 = 歌名 / 歌手·当前歌词；行2 = 上一首/播放/下一首（均分居中）；
     行3 = 进度条独立一行；行4 = 当前/总时长放在进度条下方左右。
     颜色随系统明暗主题（values vs values-night）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/cover"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginStart="12dp"
        android:layout_gravity="center_vertical"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_music_note"
        android:contentDescription="@string/widget_label" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:paddingEnd="10dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- 行1：歌名 / 歌手·当前歌词 -->
        <TextView
            android:id="@+id/songText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/artistText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- 行2：上一首 / 播放 / 下一首（均分居中） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="14dp"
                android:padding="8dp"
                android:background="@null"
                android:src="@drawable/ic_skip_previous"
                android:tint="@color/widget_icon"
                android:scaleType="fitCenter"
                android:contentDescription="@string/widget_label" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="9dp"
                android:background="@null"
                android:src="@drawable/ic_play"
                android:tint="@color/widget_icon"
                android:scaleType="fitCenter"
                android:contentDescription="@string/widget_label" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="14dp"
                android:padding="8dp"
                android:background="@null"
                android:src="@drawable/ic_skip_next"
                android:tint="@color/widget_icon"
                android:scaleType="fitCenter"
                android:contentDescription="@string/widget_label" />
        </LinearLayout>

        <!-- 行3：进度条（独立一行） -->
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_drawable"
            android:maxHeight="6dp"
            android:minHeight="6dp" />

        <!-- 行4：当前/总时长（进度条下方，左右分布） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timeCur"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="0:00"
                android:textColor="@color/widget_time"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/timeDur"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="0:00"
                android:textColor="@color/widget_time"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>