<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面播放组件 · 识曲样式（独立组件入口，参考 iOS 音乐横条）：
     封面顶满容器上下（provider 按实际高度渲染方形位图，adjustViewBounds 自适应方形宽度
     贴卡片左缘，圆角绝对 24dp 与卡片圆角重合）；
     右列(歌名/当前歌词 + 右上角听歌识曲按钮、上一首/播放/下一首、进度时间行)。
     点击右上识曲钮经深链 xianyu://open?target=recognize 拉起识曲页。
     颜色随系统明暗主题（values vs values-night）。
     歌名/歌手超长时跑马灯滚动（provider 侧 setSelected 激活）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg">

    <!-- 左：封面顶满容器上下（provider 按实际高度渲染方形位图，adjustViewBounds
         使宽度随高度撑满左缘；fitXY 保证顶满不露底；圆角绝对 24dp 与卡片圆角重合） -->
    <ImageView
        android:id="@+id/cover"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginStart="12dp"
        android:layout_gravity="center_vertical"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_music_note"
        android:contentDescription="@string/widget_label" />

    <!-- 右：信息 + 控件 + 进度（压缩内边距给大封面让位） -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:paddingStart="0dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- 行1：歌名/当前歌词（左） + 听歌识曲按钮（右上角） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/songText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/artistText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnRecognize"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:padding="6dp"
                android:background="@drawable/widget_btn_circle"
                android:src="@drawable/ic_notif_recognize"
                android:scaleType="fitCenter"
                android:contentDescription="@string/widget_label" />
        </LinearLayout>

        <!-- 行2：上一首 / 播放 / 下一首 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_horizontal">

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="12dp"
                android:padding="8dp"
                android:background="@null"
                android:src="@drawable/ic_skip_previous"
                android:tint="@color/widget_icon"
                android:scaleType="fitCenter"
                android:contentDescription="@string/widget_label" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:padding="9dp"
                android:background="@null"
                android:src="@drawable/ic_play"
                android:tint="@color/widget_icon"
                android:scaleType="fitCenter"
                android:contentDescription="@string/widget_label" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="12dp"
                android:padding="8dp"
                android:background="@null"
                android:src="@drawable/ic_skip_next"
                android:tint="@color/widget_icon"
                android:scaleType="fitCenter"
                android:contentDescription="@string/widget_label" />
        </LinearLayout>

        <!-- 行3a：进度条（独立一行） -->
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_drawable"
            android:maxHeight="6dp"
            android:minHeight="6dp" />

        <!-- 行3b：当前/总时长（进度条下方，左右分布） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timeCur"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="0:00"
                android:textColor="@color/widget_time"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/timeDur"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="0:00"
                android:textColor="@color/widget_time"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
