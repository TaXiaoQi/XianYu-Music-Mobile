<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面播放组件背景：系统通知式平面色（浅 #F2F2F7 / 深 #1C1C1E，随系统明暗反转），
     大圆角对齐系统通知卡片观感。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_card_start" />
    <!-- 半径取 widget_card_radius：API 31+ 跟随系统组件圆角（values-v31），
         与桌面裁剪半径重合，避免四角透出壁纸（亮角）。 -->
    <corners android:radius="@dimen/widget_card_radius" />
</shape>
