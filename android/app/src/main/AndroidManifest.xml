<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 本地音乐扫描：按 Android 版本细分的媒体读取权限（不再申请「所有文件访问」） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
    <!-- 在线音乐与后台/控制中心播放服务 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Android 13+：媒体控制通知需运行时申请通知权限，否则系统静默拦截 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 听歌识曲：麦克风录音 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- 悬浮歌词窗：在其他应用上层显示 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <application
        android:label="弦予音乐"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- 关闭 Impeller 渲染器（参考 PiliNara）：Impeller 的损伤追踪问题会导致
             预测返回手势期间页面只出现圆角而不跟随手指（手势进度事件已到达
             框架、动画控制器已更新，但重绘不生效），回退 Skia 后正常 -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />

        <!-- audio_service 后台媒体前台服务支持 -->
        <service android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>

        <!-- audio_service 控制中心/锁屏按键广播接收器 -->
        <receiver android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>

        <!-- 悬浮歌词窗服务 -->
        <service android:name=".LyricsOverlayService"
            android:exported="false"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- xianyu:// 深链：分享落地页点「在弦予音乐中打开」拉起并播放分享歌曲 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="xianyu"/>
            </intent-filter>
            <!-- 禁用 Flutter 引擎自带的深链处理：否则引擎会把 intent 的 data URI
                 （xianyu://song?...）当作 initial route / pushRouteInformation 传给
                 GoRouter，导致 "no routes for location: xianyu://..." 的 Page Not
                 Found 错误。深链统一走自定义 MethodChannel（xianyu/deeplink）处理。 -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- 桌面播放小组件 · 方形样式（2×2 固定：上封面/下歌名+小播放键），独立入口 -->
        <receiver
            android:name=".SquareWidgetProvider"
            android:exported="false"
            android:label="@string/widget_square_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/square_widget_info" />
        </receiver>

        <!-- 桌面播放小组件 · 识曲样式（横条：封面+右上识曲钮+三键+进度），独立入口 -->
        <receiver
            android:name=".RecognizeWidgetProvider"
            android:exported="false"
            android:label="@string/widget_recognize_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recognize_widget_info" />
        </receiver>

        <!-- 桌面播放小组件 · 歌词卡样式（4×4 固定：右上三圆钮+左封面+右五行渐变歌词+
             底部歌名/进度），独立入口 -->
        <receiver
            android:name=".LyricWidgetProvider"
            android:exported="false"
            android:label="@string/widget_lyric_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lyric_widget_info" />
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
